   "cell_type": "code",
   "source": [
    "IMG_SIZE = 224\n",
    "\n",
    "def preprocess_tiff(path: str, size: int = 224) -> torch.Tensor:\n",
    "    \"\"\"Return (2, size, size) float32 tensor scaled 0-1.\"\"\"\n",
    "    with rasterio.open(path) as src:\n",
    "        img = src.read()                                # (2,H,W)\n",
    "    img = np.array([(b - b.min()) / (b.max() - b.min() + 1e-6) for b in img])\n",
    "    img = np.array([cv2.resize(b, (size, size), interpolation=cv2.INTER_LINEAR)\n",
    "                    for b in img], dtype=np.float32)\n",
    "    return torch.from_numpy(img)"
   ],
   "metadata": {
    "trusted": true,
    "execution": {
     "iopub.status.busy": "2025-07-12T11:48:58.517603Z",
     "iopub.execute_input": "2025-07-12T11:48:58.518188Z",
     "iopub.status.idle": "2025-07-12T11:48:58.523004Z",
     "shell.execute_reply.started": "2025-07-12T11:48:58.518166Z",
     "shell.execute_reply": "2025-07-12T11:48:58.522309Z"
    }
   },
